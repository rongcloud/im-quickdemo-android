<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="cn.rongcloud.um.ui.DoMainMessageHistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <cn.rongcloud.um.ui.widget.TopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:centerText="消息接收与历史" />

        <cn.rongcloud.um.ui.widget.InputTextLinearLayout
            android:id="@+id/input_text_targetId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:leftText="请输入目标Id:" />

        <cn.rongcloud.um.ui.widget.InputTextLinearLayout
            android:id="@+id/input_text_conversation_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftText="会话类型(1私聊/3群组):" />

        <ListView
            android:id="@+id/content_listview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#999999"
            android:dividerHeight="0.5dp" />
    </LinearLayout>
</layout>
